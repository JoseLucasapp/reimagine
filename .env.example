# Optional: when configured, the login form can authenticate Supabase users by email/password.
# Without these variables, the approved prototype login still works:
# Username: Reimagine
# Password: Imagine#12345
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Census population estimates use this key when present.
# Without it, the territory builder reads real ACS B01003 population via Census Reporter.
VITE_CENSUS_API_KEY=
