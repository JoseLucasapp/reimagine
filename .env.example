# Optional: when configured, the login form can authenticate Supabase users by email/password.
# Without these variables, the approved prototype login still works:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: set to true if Vite hits Linux/WSL inotify watcher limits.
VITE_DEV_USE_POLLING=false

# Optional: Census population estimates use this key when present.
# Without it, the territory builder reads real ACS B01003 population via Census Reporter.
VITE_CENSUS_API_KEY=

# Supabase Edge Functions:
# Configure these as Supabase function secrets, not client-side Vite variables.
# approve-account-request and admin-upsert-user require SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and APP_URL.
# send-take-action-email requires SUPABASE_URL, SUPABASE_ANON_KEY, RESEND_API_KEY, and TAKE_ACTION_EMAIL_FROM.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://your-app-domain.com
RESEND_API_KEY=
TAKE_ACTION_EMAIL_FROM=Reimagine IQ <notifications@your-verified-domain.com>
# Optional fallback recipient used only when a Take Action request has no selected recipients.
TAKE_ACTION_EMAIL_FALLBACK_TO=
